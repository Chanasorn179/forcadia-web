# Local Docker PostgreSQL
POSTGRES_PASSWORD="YOUR_DATABASE_PASSWORD"

# Runtime connection. On Vercel, use the Supabase transaction pooler URL
# from Project Settings > Database > Connect (port 6543).
DATABASE_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_DATABASE_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:6543/postgres?sslmode=require"

# Prisma CLI connection for migrations, seed and Studio. Supabase's session
# pooler (port 5432) works from IPv4 environments; a direct URL also works
# when your machine has IPv6 connectivity.
DIRECT_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_DATABASE_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:5432/postgres?sslmode=require"

ADMIN_PASSWORD="YOUR_ADMIN_PASSWORD"
ADMIN_SESSION_SECRET="YOUR_RANDOM_SECRET_AT_LEAST_32_CHARACTERS"
